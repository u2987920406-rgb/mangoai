# Configuration autonome. Copier ce fichier en .env (facultatif).
HOST=127.0.0.1
PORT=3000
# Chemins relatifs à mangoai, ou chemins absolus. Ne jamais partager ces dossiers entre instances.
MANGOAI_WORKSPACE=workspace
MANGO_DATA_DIR=server/data
MANGOQA_DIR=../MangoQA
# Ollama est un service séparé. Configurer les modèles dans Réglages > Intelligence.
OLLAMA_URL=http://127.0.0.1:11434
# MANGOQA_ENABLED=false  # désactive explicitement l'auditeur
# Pour un accès réseau : HOST=0.0.0.0 et mot de passe aléatoire >=32 caractères.
# Authentification HTTP : utilisateur mango. HTTPS requis hors localhost.
# MANGO_AUTH_TOKEN=
