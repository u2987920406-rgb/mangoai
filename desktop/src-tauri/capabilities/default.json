{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions needed by the MangoOS desktop shell",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "dialog:default",
    "notification:default"
  ]
}
