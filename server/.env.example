# Configuration des fournisseurs optionnels.
# Le moteur Claude utilise la connexion du SDK Claude Code.
# Ollama local ne nécessite pas de clé ELEVE_API_KEY.
# Voir ../README.md pour le démarrage autonome.

# Optional overrides
# MODEL=sonnet
# PORT=3000
# PREVIEW_PORT=5174

# Vision snapshot budget per turn (idea 12): Élite vs MVP mode
# VISION_BUDGET=10
# VISION_BUDGET_MVP=3

# GitHub one-click push (idea 16): personal access token with the "repo" scope.
# Create one at https://github.com/settings/tokens (classic) or a fine-grained
# token with Contents: read/write. The owner login is read from the API.
# GITHUB_TOKEN=ghp_...

# Élève local (jalon D) — modèle OSS qui traite la routine à coût zéro.
# Défaut : Ollama local (gratuit, souverain). Lancer « ollama serve » à part.
# ELEVE_MODEL=gemma4:12b
#
# Option « Élève turbo » — endpoint compatible OpenAI (DeepSeek, Together, etc.) :
# plus puissant mais PAYANT et non local (le code/prompts partent chez un tiers).
# Passe ELEVE_PROVIDER=openai puis renseigne l'URL de base, la clé et le modèle.
# ELEVE_PROVIDER=ollama            # ollama (défaut) | openai
# ELEVE_API_URL=https://api.deepseek.com/v1
# ELEVE_API_KEY=sk-...
# ELEVE_MODEL=deepseek-chat        # nom du modèle côté provider

# ── Chantier #57 — Indépendance fournisseur LLM ──────────────────────────────
#
# Provider global pour toutes les features IA (défaut : claude = abonnement $0).
# Valeurs acceptées : claude | ollama | openai | deepseek | mistral | groq
# LLM_PROVIDER=claude
#
# Surcharge par feature (prioritaire sur LLM_PROVIDER) :
# FEEDBACK_PROVIDER=claude
# QA_PROVIDER=claude
# IDEATION_PROVIDER=claude
# DOC_PROVIDER=claude
# CRON_PROVIDER=claude
#
# Modèle utilisé par le reviewer Hermes (défaut : haiku via l'abonnement) :
# REVIEW_MODEL=haiku
#
# Clés pour les providers OpenAI-compatibles tiers :
# DEEPSEEK_API_KEY=sk-...          # deepseek-chat par défaut
# MISTRAL_API_KEY=...              # mistral-large-latest par défaut
# GROQ_API_KEY=gsk_...             # llama-3.3-70b-versatile par défaut
#
# Provider openai générique (URL + clé libres) :
# LLM_OPENAI_URL=https://api.deepseek.com/v1
# LLM_OPENAI_KEY=sk-...

# ── Idée #73 — L'armée automatique ───────────────────────────────────────────
#
# Patrouilleurs spécialisés (accessibilité, sécurité, SEO, perf, bundle) réveillés
# AUTOMATIQUEMENT après chaque tour selon les fichiers modifiés + le type de projet.
# Tournent en arrière-plan ($0 via l'abonnement) ; rapport compact injecté au chat.
# Activé par défaut. Kill-switch :
# PATROL_ENABLED=0
#
# Provider des patrouilleurs (défaut : claude = abonnement $0) :
# PATROL_PROVIDER=claude

# ── Idée #76 — Auto-réécriture des règles (évolution des axiomes) ─────────────
#
# Mango analyse ses corrections récurrentes et PROPOSE des évolutions de ses
# axiomes (à valider à la main). Provider de l'analyse (défaut : claude $0) :
# PROMPT_EVOLUTION_PROVIDER=claude
# Le créneau nocturne optionnel se règle dans le panneau (off par défaut).

# ─────────────────────────────────────────────────────────────────────────────
# Gates QUALITÉ recommandés (nuit 2026-07-03 « level-up ») — copiez-les tels quels.
# Ils rendent le Gardien de clôture pleinement effectif : « build vert » ne suffit
# jamais, une app médiocre ou aux fausses images ne sort pas verte.
# ─────────────────────────────────────────────────────────────────────────────
# Gardien TOUJOURS actif (intention + goût + QA dans la boucle) — ne jamais désactiver.
ELEVE_CLOSURE_GATE=on
# Le VL du gate lit le goût appris (qwen3.5:cloud tient 1500 car — 0 le droppait).
GATE_TASTE_AXIOMS_CHARS=1500
# Plancher : un goût FIABLE sous ce seuil bloque même en mode observation (échec grossier).
ELEVE_GATE_TASTE_FLOOR=50
# Parcours de clôture : l'app doit charger + réagir sans erreur console.
ELEVE_GATE_PARCOURS=on
# Budgets de finition (24 itérations coupaient les apps élite en plein polish).
ELEVE_AGENTIC_MAX_ITER=36
ELEVE_GATE_RELANCE_MAX=3
# Timeouts réseau (anti-deadlock : un fetch/query qui pend ne gèle plus le tour).
# ELEVE_FETCH_TIMEOUT_MS=180000
# CLAUDE_QUERY_TIMEOUT_MS=300000
# Garde « vraies images » : refuse les placeholders aléatoires vivants (opt-out = off).
# ELEVE_GATE_PLACEHOLDERS=on

# Pexels (images RÉELLES — sans clé, l'Élève ne pose PLUS de placeholder, il fait
# des dégradés/patterns CSS). Clé gratuite : https://www.pexels.com/api/
# PEXELS_API_KEY=

# Budgets de la boucle nocturne autonome (deadlines MURALES, 2026-07-03) :
# NOCTURNAL_PROJECT_BUDGET_MIN=45
# NOCTURNAL_BATCH_BUDGET_H=8

# Super agent de finition « Esthète » — budget d'itérations dédié.
# ESTHETE_MAX_ITER=10

# ═════════════════════════════════════════════════════════════════════════════
# PHASE 1 — DISTRIBUTION (docs/plan-distribution.md §3.2, 2026-07-04)
# Liste EXHAUSTIVE des variables restantes lues par server/src/*.ts (grep process.env.),
# absentes ci-dessus. Valeurs volontairement VIDES — le code applique ses propres défauts
# documentés en commentaire. Rien ici n'est obligatoire à part ELEVE_API_KEY (voir plus haut).
# ═════════════════════════════════════════════════════════════════════════════

# ── Clés API tierces (secrets — laisser vide sauf besoin réel) ──────────────
# Clé API Krea (maillon cloud de génération d'image, repli si ComfyUI échoue).
KREA_API_KEY=
# Token d'accès Bitwarden Secrets Manager (bws) pour le coffre-fort de secrets.
BWS_ACCESS_TOKEN=
# Clé API Tavily pour la recherche web robuste orientée agents.
TAVILY_API_KEY=
# URL de l'endpoint Firechrome (moteur de recherche keyless supplémentaire).
# Si renseigné, Firechrome est essayé AVANT DuckDuckGo/Mojeek dans la chaîne de
# recherche web (chercher_web). Format : https://search.firechrome.example/search
# FIRECHROME_SEARCH_URL=
# Token Vercel optionnel pour le déploiement (jamais requis).
VERCEL_TOKEN=
# Clé secrète Stripe pour créer les sessions de paiement Checkout.
STRIPE_SECRET_KEY=
# Clé API du proxy LiteLLM (défaut placeholder sk-litellm-local).
LITELLM_API_KEY=
# Clé de déchiffrement du coffre-fort local de secrets (MANGO_VAULT_FILE).
MANGO_VAULT_KEY=
# Chemin du fichier chiffré du coffre-fort local de secrets.
MANGO_VAULT_FILE=

# ── Providers LLM par capacité (surchargent LLM_PROVIDER pour une feature) ──
AGENT_FACTORY_PROVIDER=
AGENT_LLM_PROVIDER=
CONTROLEUR_PROVIDER=
DESIGNREVIEW_PROVIDER=
INDEX_PROVIDER=
NOCTURNAL_JUDGE_PROVIDER=
NOTES_PROVIDER=
RADAR_PROVIDER=
RAG_PROVIDER=
SUPERAGENT_PROVIDER=
# AGENT_FACTORY_PROVIDER : provider LLM utilisé par la fabrique d'agents (agent-factory).
# AGENT_LLM_PROVIDER : provider LLM utilisé par le coordinateur/les routes d'agents génériques.
# CONTROLEUR_PROVIDER : provider LLM du contrôleur temporel QA (qa-temporal).
# DESIGNREVIEW_PROVIDER : provider LLM de la revue de design (défaut claude).
# INDEX_PROVIDER : provider LLM utilisé pour l'indexation multi-projets (défaut ollama).
# NOCTURNAL_JUDGE_PROVIDER : provider LLM du juge nocturne (défaut claude).
# NOTES_PROVIDER : provider LLM utilisé pour le RAG de notes (défaut claude).
# RADAR_PROVIDER : provider LLM du radar de veille (défaut claude).
# RAG_PROVIDER : provider LLM utilisé pour la recherche augmentée (RAG) des notes (défaut claude).
# SUPERAGENT_PROVIDER : provider LLM du super-agent-builder (défaut claude).

# ── Ollama / modèles locaux ───────────────────────────────────────────────────
OLLAMA_URL=
OLLAMA_SUMMARY_MODEL=
NOTES_EMBED_MODEL=
VL_MODEL=
LAYOUT_AGENT_MODEL=
UXUI_AGENT_MODEL=
PDF_AGENT_MODEL=
LLM_CLAUDE_MODEL=
LITELLM_BASE_URL=
LITELLM_MODEL=
LLM_OPENAI_MODEL=
LLM_SEMANTIC_CACHE=
# OLLAMA_URL : URL de base du serveur Ollama local (défaut http://localhost:11434).
# OLLAMA_SUMMARY_MODEL : modèle Ollama utilisé pour les résumés (sinon ELEVE_MODEL).
# NOTES_EMBED_MODEL : nom du modèle d'embeddings Ollama pour les notes (défaut nomic-embed-text).
# VL_MODEL : nom du modèle de vision-langage utilisé (défaut qwen3-vl:8b).
# LAYOUT_AGENT_MODEL : modèle Élève utilisé par l'agent Layout CSS (sinon ELEVE_MODEL).
# UXUI_AGENT_MODEL : modèle Élève utilisé par l'agent UX/UI (sinon ELEVE_MODEL).
# PDF_AGENT_MODEL : modèle Ollama utilisé par l'agent de traitement PDF.
# LLM_CLAUDE_MODEL : nom du modèle Claude utilisé (défaut sonnet).
# LITELLM_BASE_URL : URL de base du proxy LiteLLM (défaut http://localhost:4000/v1).
# LITELLM_MODEL : nom du modèle utilisé via le proxy LiteLLM (défaut gpt-4o-mini).
# LLM_OPENAI_MODEL : nom du modèle utilisé sur l'endpoint OpenAI-compatible (défaut deepseek-chat).
# LLM_SEMANTIC_CACHE : active le cache exact→sémantique des appels LLM purs (juges, extractions), défaut OFF.

# ── Élève — compétences et outils (chaque coupure = "off" pour désactiver) ──
ELEVE_AGENTIC=
ELEVE_AGENTIC_CTX_MAX=
ELEVE_AGENTIC_MAX_CORRECTIONS=
ELEVE_ARCHIVE=
ELEVE_ARTEFACT=
ELEVE_AUTOTEST=
ELEVE_AXIOM_CAP=
ELEVE_BRAIN_ESCALATE=
ELEVE_BRICKS=
ELEVE_BUDGET_PROMPT_CHARS=
ELEVE_BUDGET_TOOL_CALLS=
ELEVE_CONTENT=
ELEVE_DELEGATE=
ELEVE_DELEGATE_AGENTIC=
ELEVE_DELEGATE_MAX_AGENTS=
ELEVE_DELEGATE_MAX_DEPTH=
ELEVE_DELEGATE_MIN_WINRATE=
ELEVE_DELEGATE_MIN_USES=
ELEVE_DOCUMENT=
ELEVE_ESCALATE_ON_BLOCK=
ELEVE_ETAT=
ELEVE_EXPLORE_BEFORE_ACT_MAX=
ELEVE_FETCH_TIMEOUT_MS=
ELEVE_FILE_BUDGET=
ELEVE_FILE_MAX=
ELEVE_FLUX=
ELEVE_GATE_BALANCE=
ELEVE_GATE_DUAL_SKIP_BLOCK=
ELEVE_GATE_INTENT_MIN=
ELEVE_GATE_PLACEHOLDERS=
ELEVE_GATE_TASTE_MIN=
ELEVE_GATE_TASTE_OBSERVE=
ELEVE_GATE_TESTS=
ELEVE_GATE_WCAG_MAX_FAILS=
ELEVE_GODOT=
ELEVE_HOOKS=
ELEVE_HTTP=
ELEVE_IMAGE_CHECK=
ELEVE_KREA=
ELEVE_MAX_ATTEMPTS=
ELEVE_MCP_EXTERNAL=
ELEVE_PARCOURS=
ELEVE_PARCOURS_BUDGET=
ELEVE_PLANIFIER=
ELEVE_PLAN_V2=
ELEVE_REFLEXION=
ELEVE_REFLEXION_EVERY=
ELEVE_REFLEXION_MAX=
ELEVE_RESUME=
ELEVE_RUN_TIMEOUT_MS=
ELEVE_SELF_RELANCE_MAX=
ELEVE_SITE=
ELEVE_SITE_BUDGET=
ELEVE_SITE_IMAGES=
ELEVE_SITE_IMAGE_GEN=
ELEVE_SITE_VISION=
ELEVE_SPECULATIVE=
ELEVE_STRATEGE=
ELEVE_STRATEGE_BRAIN=
ELEVE_STRATEGE_BUDGET=
ELEVE_STRATEGE_LEARN=
ELEVE_UNITY=
ELEVE_VAULT=
ELEVE_VISION=
ELEVE_VISION_BUDGET=
ELEVE_WEB=
ELEVE_ADD_DEP_TIMEOUT_MS=
# (descriptions, dans l'ordre ci-dessus) :
# ELEVE_AGENTIC : coupure de la boucle agentique de l'Élève ("off" pour revenir au contrat simple).
# ELEVE_AGENTIC_CTX_MAX : plafond du contexte (caractères) de la boucle agentique (défaut 60000).
# ELEVE_AGENTIC_MAX_CORRECTIONS : nombre max de corrections automatiques en boucle agentique (défaut 8).
# ELEVE_ARCHIVE : coupure de l'outil de lecture d'archives zip/rar.
# ELEVE_ARTEFACT : coupure de la compétence artefacts réutilisables.
# ELEVE_AUTOTEST : active la compétence auto-test (ecris_test/lance_tests), défaut OFF.
# ELEVE_AXIOM_CAP : plafond du nombre d'axiomes injectés par appel Élève.
# ELEVE_BRAIN_ESCALATE : active l'échelle d'escalade du cerveau exécutant.
# ELEVE_BRICKS : active l'assemblage d'infra back à partir de briques éprouvées, défaut OFF.
# ELEVE_BUDGET_PROMPT_CHARS : plafond du poids contexte cumulé (caractères) pour un run délégué.
# ELEVE_BUDGET_TOOL_CALLS : plafond du nombre total d'appels d'outils pour un run délégué.
# ELEVE_CONTENT : active les outils "contenu" transmis à l'Élève, défaut OFF.
# ELEVE_DELEGATE : active la délégation à des agents spécialistes.
# ELEVE_DELEGATE_AGENTIC : active la délégation en mode agentique (sinon simple conseil), défaut OFF.
# ELEVE_DELEGATE_MAX_AGENTS : nombre max d'agents délégués pouvant être spawnés (défaut 4).
# ELEVE_DELEGATE_MAX_DEPTH : profondeur max de délégation en cascade (défaut 2).
# ELEVE_DELEGATE_MIN_WINRATE : (revue Fable #3, 2026-07-07) winrate minimal en dessous duquel
# un agent forgé est ignoré par le matching (défaut 0.25). 0 = filtre désactivé.
# ELEVE_DELEGATE_MIN_USES : nb de consultations avant que le winrate d'un agent soit jugé
# significatif (défaut 4) — un agent tout juste forgé n'est jamais blacklisté sur du bruit.
# ELEVE_DOCUMENT : coupure de l'outil de lecture de documents.
# ELEVE_ESCALATE_ON_BLOCK : active l'escalade vers Claude en cas de blocage, opt-in strict, défaut OFF.
# ELEVE_ETAT : maintient un état de travail compact réinjecté après compaction du contexte.
# ELEVE_EXPLORE_BEFORE_ACT_MAX : nombre max d'explorations avant action forcée (défaut 6).
# ELEVE_FETCH_TIMEOUT_MS : timeout des appels réseau de l'Élève (défaut 180000 ms, plancher 30000).
# ELEVE_FILE_BUDGET : plafond du nombre de fichiers modifiables par run (défaut selon profil).
# ELEVE_FILE_MAX : taille max de fichier traitable par run (défaut selon profil).
# ELEVE_FLUX : active la génération d'images IA locale via Flux/ComfyUI, défaut OFF.
# ELEVE_GATE_BALANCE : coupure du contrôle d'équilibre visuel du Gardien de clôture.
# ELEVE_GATE_DUAL_SKIP_BLOCK : durcit le Gardien : bloque si juge ET critique visuelle sont indisponibles.
# ELEVE_GATE_INTENT_MIN : score minimal d'intention exigé par le Gardien de clôture (défaut 70).
# ELEVE_GATE_PLACEHOLDERS : coupure de la garde anti-placeholders du Gardien de clôture.
# ELEVE_GATE_TASTE_MIN : score minimal de goût exigé par le Gardien de clôture (défaut 70).
# ELEVE_GATE_TASTE_OBSERVE : mode observation du score goût sans bloquer ("off" pour en faire un frein).
# ELEVE_GATE_TESTS : active l'exécution de la suite de tests du projet par le Gardien, défaut OFF.
# ELEVE_GATE_WCAG_MAX_FAILS : nombre max d'échecs WCAG tolérés par le Gardien de clôture (défaut 0).
# ELEVE_GODOT : active la compétence Godot natif de l'Élève, défaut OFF.
# ELEVE_HOOKS : active le passage par les hooks PreToolUse/PostToolUse de la boucle Élève, défaut OFF.
# ELEVE_HTTP : coupure de l'outil d'appels HTTP externes.
# ELEVE_IMAGE_CHECK : coupure de la vérification des images mortes/non réparables.
# ELEVE_KREA : active le maillon cloud Krea comme repli si ComfyUI échoue, défaut OFF.
# ELEVE_MAX_ATTEMPTS : nombre max de tentatives d'un appel Élève (défaut selon profil).
# ELEVE_MCP_EXTERNAL : active le chargement d'outils MCP externes pré-chargés, défaut OFF.
# ELEVE_PARCOURS : coupure de l'outil de test de parcours utilisateur.
# ELEVE_PARCOURS_BUDGET : budget de tests de parcours par tâche (défaut 4).
# ELEVE_PLANIFIER : coupure de l'outil de planification.
# ELEVE_PLAN_V2 : active le plan structuré re-planifiable (statuts d'étapes).
# ELEVE_REFLEXION : active une phase de réflexion explicite périodique ou après blocage.
# ELEVE_REFLEXION_EVERY : fréquence (en itérations) de la phase de réflexion (défaut 8, plancher 3).
# ELEVE_REFLEXION_MAX : nombre max de phases de réflexion par run (défaut 3, plancher 1).
# ELEVE_RESUME : active le snapshot de reprise inter-session de la boucle agentique.
# ELEVE_RUN_TIMEOUT_MS : timeout d'exécution d'une commande lancée par l'Élève (défaut 120000 ms).
# ELEVE_SELF_RELANCE_MAX : nombre max d'auto-relances de l'Élève après clôture (défaut 6).
# ELEVE_SITE : coupure de l'outil de construction/enrichissement de site.
# ELEVE_SITE_BUDGET : budget d'appels pour l'outil de construction de site (défaut 3).
# ELEVE_SITE_IMAGES : coupure de l'insertion de vraies photos Pexels dans les sites générés.
# ELEVE_SITE_IMAGE_GEN : active la génération d'images pour les suggestions d'images de site.
# ELEVE_SITE_VISION : coupure de l'appel VL cloud pour enrichir les pages de site.
# ELEVE_SPECULATIVE : active la pré-passe spéculative avant exécution complète, défaut OFF.
# ELEVE_STRATEGE : mode de routage du Stratège vers un remède choisi (défaut "off").
# ELEVE_STRATEGE_BRAIN : active le cerveau cloud du Stratège pour les cas ambigus, défaut "off".
# ELEVE_STRATEGE_BUDGET : budget d'actions du Stratège (défaut 3).
# ELEVE_STRATEGE_LEARN : active l'apprentissage du Stratège à partir des remèdes appliqués, défaut OFF.
# ELEVE_UNITY : active la compétence Unity/C# de l'Élève, défaut OFF.
# ELEVE_VAULT : active l'outil "utilise_secret" du coffre-fort de secrets, défaut OFF.
# ELEVE_VISION : active l'outil de vision sur son propre rendu ("vois_ecran"), défaut OFF.
# ELEVE_VISION_BUDGET : budget d'appels vision par run.
# ELEVE_WEB : coupure de l'outil de recherche web.
# ELEVE_ADD_DEP_TIMEOUT_MS : timeout de l'ajout de dépendances npm (défaut 180000 ms).

# ── Gates qualité additionnelles (axiomes, goût) ─────────────────────────────
AXIOMS_DRIFT=
AXIOMS_ROTATE=
AXIOMS_VALIDATION=
TASTE_CLOSED_LOOP=
TASTE_JUDGE=
GATE_TASTE_PASSES=
# AXIOMS_DRIFT : active le détecteur de contradiction/dérive à l'écriture d'un axiome.
# AXIOMS_ROTATE : active la rotation du registre d'axiomes au-delà du cap (archive le surplus).
# AXIOMS_VALIDATION : active la validation mécanique (dédup sémantique + quarantaine) avant promotion.
# TASTE_CLOSED_LOOP : coupure de la boucle fermée goût (favoris appris).
# TASTE_JUDGE : coupure du juge de goût appris avant le choix.
# GATE_TASTE_PASSES : nombre de passes scorées moyennées par le juge de goût (défaut 3, borné 1-5).

# ── Brain-Dispatch / cerveaux (routage multi-modèles) ────────────────────────
BRAIN_DISPATCH=
BRAIN_FALLBACK=
BRAIN_LOCAL_ONLY=
BRAIN_PROFILE=
BRAINS_DIR=
BRAIN_REGISTRY_FILE=
# BRAIN_DISPATCH : active le routage Brain-Dispatch (cerveau dédié par lentille/patrouilleur).
# BRAIN_FALLBACK : active le repli automatique inter-providers sur timeout/erreur transport.
# BRAIN_LOCAL_ONLY : "rideau de fer" souveraineté : force localOnly sur tous les rôles, refuse tout cloud.
# BRAIN_PROFILE : nom du profil de cerveaux à charger (data/brain-profiles/<nom>.json).
# BRAINS_DIR : répertoire où sont stockés les fichiers de cerveaux (.brains).
# BRAIN_REGISTRY_FILE : chemin explicite du fichier de registre des cerveaux (override testabilité).

# ── Stratège ──────────────────────────────────────────────────────────────────
STRATEGE_BRAIN_ESCALATE=
STRATEGE_ESCALATE_AGENT=
STRATEGE_GLOBAL=
STRATEGE_QUESTION_DEMANDE=
STRATEGIST_STATE_FILE=
# STRATEGE_BRAIN_ESCALATE : active l'escalade cloud du barreau 2 du Stratège, défaut OFF (local seul).
# STRATEGE_ESCALATE_AGENT : nom de l'agent du barreau 2 (cloud supérieur) du Stratège (défaut "juge").
# STRATEGE_GLOBAL : active le cycle du Stratège global proactif en fin de lot nocturne.
# STRATEGE_QUESTION_DEMANDE : active la remise en question de la demande de Raf (dépend de STRATEGE_GLOBAL).
# STRATEGIST_STATE_FILE : chemin du fichier d'état du Stratège, override testabilité.

# ── Relais / kernel / métriques ───────────────────────────────────────────────
RELAY_FUNCTIONAL_GATE=
RELAY_FUNCTIONAL_MIN=
RELAY_INJECT_MEANS=
RELAY_INJECT_PROC_BODY_MAX=
RELAY_INJECT_PROC_CAP=
CURATION_DAMP_ALPHA=
REUSE_IMPACT_WINDOW=
PROCEDURE_MIN_SIMILARITY=
BLACKBOARD_DB=
MEMORY_MANIFEST=
# RELAY_FUNCTIONAL_GATE : garde fonctionnelle du relais (empêche de conclure sur une app vide), mettre "1".
# RELAY_FUNCTIONAL_MIN : score fonctionnel minimal exigé par la garde du relais (défaut 5).
# RELAY_INJECT_MEANS : active l'injection de moyens (procédures/constellations) dans le relais, mettre "1".
# RELAY_INJECT_PROC_BODY_MAX : taille max (caractères) du corps de procédure injecté (défaut 1100).
# RELAY_INJECT_PROC_CAP : nombre max de procédures injectées par relais (défaut 2).
# CURATION_DAMP_ALPHA : coefficient d'amortissement de l'effet de curation du kernel.
# REUSE_IMPACT_WINDOW : fenêtre de calcul de l'impact de réutilisation dans les métriques du kernel.
# PROCEDURE_MIN_SIMILARITY : seuil de similarité minimal pour réutiliser une procédure (défaut 0.65).
# BLACKBOARD_DB : chemin du fichier SQLite de persistance du Blackboard (sinon mémoire volatile).
# MEMORY_MANIFEST : active l'écriture/maintien de .memory-manifest.json (versions de schéma des magasins).

# ── Génération d'image locale (Flux / ComfyUI) ───────────────────────────────
FLUX_COMFY_URL=
FLUX_PYTHON=
FLUX_CFG=
FLUX_CLIP1=
FLUX_CLIP2=
FLUX_SAMPLER=
FLUX_SCHEDULER=
FLUX_SERIALIZE_GPU=
FLUX_STEPS=
FLUX_TIMEOUT_MS=
FLUX_UNET=
FLUX_UPSCALE_MODEL=
FLUX_VAE=
KREA_API_URL=
KREA_TIMEOUT_MS=
# FLUX_COMFY_URL : URL de l'instance ComfyUI locale (défaut http://127.0.0.1:8188).
# FLUX_PYTHON : chemin de l'exécutable Python avec rembg/PIL/OpenCV installés (détourage/découpage).
# FLUX_CFG : valeur CFG (guidage) du pipeline de génération d'image Flux (défaut 1).
# FLUX_CLIP1 / FLUX_CLIP2 : fichiers modèles CLIP utilisés par ComfyUI/Flux.
# FLUX_SAMPLER / FLUX_SCHEDULER : sampler/scheduler utilisés par ComfyUI/Flux (défaut euler/simple).
# FLUX_SERIALIZE_GPU : sérialise les appels GPU pour éviter un OOM.
# FLUX_STEPS : nombre d'étapes de diffusion Flux (défaut 4).
# FLUX_TIMEOUT_MS : timeout de génération d'image ComfyUI (défaut 360000 ms).
# FLUX_UNET / FLUX_UPSCALE_MODEL / FLUX_VAE : fichiers modèles UNet/upscale/VAE utilisés par ComfyUI/Flux.
# KREA_API_URL : URL de base de l'API Krea (défaut https://api.krea.ai).
# KREA_TIMEOUT_MS : timeout des appels à l'API Krea (défaut 120000 ms).

# ── Godot / Unity (domaines applicatifs alternatifs au web) ──────────────────
GODOT_PATH=
UNITY_PATH=
MANGOOS_DOMAIN=
# GODOT_PATH : chemin de l'exécutable console Godot 4 (requis pour construire le domaine Godot).
# UNITY_PATH : chemin de l'exécutable Unity Editor (requis pour construire le domaine Unity).
# MANGOOS_DOMAIN : force le domaine métier du projet (web/Unity/Godot) au lieu de l'auto-détection.

# ── Réseau / ports / serveur ──────────────────────────────────────────────────
BACKEND_PORT=
HOST=
MAX_PREVIEWS=
PREVIEW_AUTO_INSTALL=
PREVIEW_SWEEP=
PREVIEW_SWEEP_SPAN=
MANGO_URL=
NODE_ENV=
# BACKEND_PORT : alias legacy de PORT lu par certains scripts (défaut 3000).
# HOST : adresse d'écoute du serveur backend (défaut 0.0.0.0, mettre localhost pour repli local).
# MAX_PREVIEWS : nombre max de serveurs de prévisualisation Vite gardés en pool LRU (défaut 3).
# PREVIEW_AUTO_INSTALL : coupure de l'installation automatique des dépendances de prévisualisation.
# PREVIEW_SWEEP : coupure du balayage anti-orphelins des prévisualisations Vite.
# PREVIEW_SWEEP_SPAN : étendue de la plage de ports balayée pour les orphelins (défaut 120).
# MANGO_URL : URL de base du backend MangoOS pour les scripts clients (défaut http://localhost:3000).
# NODE_ENV : environnement d'exécution Node (development/production).

# ── MangoQA / QA ──────────────────────────────────────────────────────────────
MANGOQA_ENABLED=
MANGOQA_CLOSURE_TIMEOUT=
QA_VERDICT_ASYNC_TIMEOUT=
QA_VERDICT_TIMEOUT=
TEMPORAL_AWARENESS=
# MANGOQA_ENABLED : active/désactive explicitement MangoQA ("true"/"false").
# MANGOQA_CLOSURE_TIMEOUT : timeout d'attente du verdict MangoQA à la clôture (défaut 60000 ms).
# QA_VERDICT_ASYNC_TIMEOUT : timeout du verdict QA asynchrone (défaut 300000 ms).
# QA_VERDICT_TIMEOUT : timeout du verdict QA synchrone (défaut 60000 ms).
# TEMPORAL_AWARENESS : active l'injection d'un bloc TEMPS (date/heure/fuseau) en tête du system prompt (défaut ON).

# ── Boucles nocturnes / entraînement / budgets ───────────────────────────────
NOCTURNAL_GLOBAL_BUDGET_USD=
TONIGHT_BUDGET_MIN=
TONIGHT_LIMIT=
FINISH_BUDGET_MIN=
FINISH_BUDGET_USD=
GRAND_CHANTIER=
GRAND_CHANTIER_BUDGET_USD=
TRAIN_ESCALATE_MODEL=
TRAIN_LOOP_OLLAMA_MAX_FAILS=
TRAIN_LOOP_PROJECT_BUDGET_MIN=
SELF_EVOLVE=
SELF_EVOLVE_AUTO=
SELF_EVOLVE_MAX_FORGES=
SELF_EVOLVE_OPUS_BUDGET_USD=
SELF_EVOLVE_MAX_AGENTS_TOTAL=
SELF_EVOLVE_MAX_FORGE_ATTEMPTS=
SELF_EVOLVE_BLOCKERS=
# NOCTURNAL_GLOBAL_BUDGET_USD : plafond de dépense $ partagé de la boucle nocturne. Armé PAR DÉFAUT (NOCTURNAL_BUDGET_HARD) ; absent/0/invalide → plafond fini de 20 $ (jamais illimité). Désarmer : NOCTURNAL_BUDGET_HARD=off.
# TONIGHT_BUDGET_MIN : budget temps (minutes) du run nocturne "run-tonight" (défaut 480).
# TONIGHT_LIMIT : tronque la liste d'apps du run nocturne aux N premières (dry-run).
# FINISH_BUDGET_MIN / FINISH_BUDGET_USD : budget temps/coût du runner de finition (défaut 480 min, illimité $).
# GRAND_CHANTIER : autorise l'exécution du "Grand Chantier" (runner batch), sinon refuse.
# GRAND_CHANTIER_BUDGET_USD : plafond de coût Claude du Grand Chantier en $ (0 = illimité).
# TRAIN_ESCALATE_MODEL : modèle Claude utilisé pour l'escalade en boucle d'entraînement (défaut sonnet).
# TRAIN_LOOP_OLLAMA_MAX_FAILS : nombre d'échecs Ollama consécutifs avant arrêt du lot (défaut 3).
# TRAIN_LOOP_PROJECT_BUDGET_MIN : budget temps (minutes) par projet en boucle d'entraînement (défaut 45).
# SELF_EVOLVE : coupure du pipeline d'auto-évolution (repère les lacunes, sans forger).
# SELF_EVOLVE_AUTO : la forge s'arme SANS clic humain (sous disjoncteur ci-dessous).
# SELF_EVOLVE_MAX_FORGES : plafond de forges automatiques PAR RUN (défaut 1).
# SELF_EVOLVE_OPUS_BUDGET_USD : plafond de dépense Opus des forges auto par run (défaut 0.50).
# SELF_EVOLVE_MAX_AGENTS_TOTAL : (revue Fable #2, 2026-07-07) plafond GLOBAL cross-run sur la
# taille du registre de spécialistes (défaut 24) — freine la dérive lente sur plusieurs jours,
# indépendamment du plafond par-run.
# SELF_EVOLVE_MAX_FORGE_ATTEMPTS : (revue Fable #1, 2026-07-07) nb de tentatives de forge
# ratées tolérées PAR LACUNE avant qu'elle n'attende une validation manuelle dans l'Atelier
# au lieu de re-dépenser de l'Opus à chaque run (défaut 3).
# SELF_EVOLVE_BLOCKERS : classes de blocage qui ouvrent une lacune (CSV, défaut les 4
# classes "mur de capacité" : plateau-iterations, wandering, knowledge-gap, wrong-tool).

# ── Divers (indexation, savoir, agents spécialisés) ──────────────────────────
CLAUDE_QUERY_TIMEOUT_MS=
COMPACT_THRESHOLD=
CONTEXT_WINDOW=
INDEX_BATCH_SIZE=
INDEX_MAX_FILES=
INSPECT_TIMING=
INTENT_ROUTER_LLM=
LIMITES_FILE=
MODELS=
OPEN_GAPS_FILE=
SAVOIR_FETCH_DELAY_MS=
SAVOIR_FETCH_MAX=
SKIP_BUILD=
SPECIALIST_AGENTS_FILE=
TOEIC_PROJECT=
VISION_PREWARM=
# CLAUDE_QUERY_TIMEOUT_MS : timeout des requêtes Claude (défaut 300000 ms, plancher 60000).
# COMPACT_THRESHOLD : seuil de déclenchement de la compaction du contexte (défaut 0.7).
# CONTEXT_WINDOW : taille de la fenêtre de contexte du modèle (défaut 200000 tokens).
# INDEX_BATCH_SIZE : taille de lot pour l'indexation via Ollama (défaut 3).
# INDEX_MAX_FILES : nombre max de fichiers indexés par run (défaut 60).
# INSPECT_TIMING : active les logs de timing de l'inspection de projet.
# INTENT_ROUTER_LLM : active le routeur LLM de capacités en repli d'ambiguïté, défaut OFF.
# INTEGRITY_AUDIT : coupure du vérificateur d'intégrité des registres d'état (#196
#   fault-finding Partie 1, 2026-07-23) — "off" pour désactiver, ON par défaut.
# INTEGRITY_AUDIT_INTERVAL_MS : cadence (ms) entre deux audits, défaut 3600000 (1h).
# INTEGRITY_SNAPSHOT_FILE / INTEGRITY_AUDIT_LOG_FILE : chemins du snapshot/journal
#   d'intégrité (override testabilité).
# LIMITES_FILE : chemin du fichier de limites de l'agent-forge (override testabilité).
# MODELS : liste (CSV) de modèles Élève à comparer dans compare-eleves.ts.
# CONCEPT_GAPS_FILE : chemin du fichier de lacunes de sens (concept-gaps.json), override testabilité.
# CONCEPT_TELEMETRY_FILE : chemin du journal de vérifications (concept-verifications.jsonl), override testabilité.
# ELEVE_CONTEXT_LOOP : boucle de vérification contextuelle Étape 1 (gabarit↔sens réel du mot), défaut OFF — voir flags.ts.
# OPEN_GAPS_FILE : chemin du fichier de lacunes ouvertes (open-gaps.json), override testabilité.
# SAVOIR_FETCH_DELAY_MS / SAVOIR_FETCH_MAX : délai/plafond des récupérations de transcripts (savoir vidéo).
# SKIP_BUILD : saute l'étape de build dans compare-eleves.ts, mettre "1".
# SPECIALIST_AGENTS_FILE : chemin du fichier des agents spécialistes (override testabilité).
# TOEIC_PROJECT : nom du projet TOEIC ciblé par les scripts run-toeic-* (défaut toeic-mango).
# VISION_PREWARM : coupure du préchauffage du modèle de vision local.

# Note : quelques variables de test unitaire (TEST_KEY_X, TEST_KEY_SECURE, NOPE_VAR_ABSENTE,
# ELEVE_API_KEY_TEST_LEAK, TEST_MODEL) apparaissent dans le grep mais sont des fixtures de
# test-*.ts sans usage en production — volontairement omises ici.
