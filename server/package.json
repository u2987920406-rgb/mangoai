{
  "name": "mangoos-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "watch:supervised": "tsx src/watchdog.ts",
    "check-key": "tsx src/check-key.ts",
    "test": "node --import tsx src/test-runner.ts --tier smoke",
    "test:offline": "node --import tsx src/test-runner.ts --tier offline",
    "test:llm": "node --import tsx src/test-runner.ts --tier llm",
    "test:full": "node --import tsx src/test-runner.ts --tier full",
    "test:list": "node --import tsx src/test-runner.ts --list",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@napi-rs/canvas": "^1.0.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "multer": "^2.2.0",
    "node-unrar-js": "^2.0.2",
    "officeparser": "^7.2.1",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.100.0"
  },
  "allowScripts": {
    "esbuild@0.28.0": true,
    "esbuild@0.27.3": true,
    "sharp@0.34.5": true
  },
  "overrides": {
    "officeparser": {
      "pdfjs-dist": "$pdfjs-dist"
    }
  }
}
